{
  "name": "gemini-space",
  "version": "1.0.0",
  "description": "Give Google Gemini Web (and Gemini Task subagents) native Antigravity-style local coding tools over MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cunninghamcard-bit/gemini-space.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "gemini-space": "bin/gemini-space.js",
    "devspace": "bin/devspace.js",
    "gemini-space-stdio": "bin/gemini-space-stdio.js",
    "gemini-space-call": "bin/gemini-space-call.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "start": "node --import ./bin/silence-sqlite-warning.js dist/cli.js serve",
    "test": "tsx --import ./bin/silence-sqlite-warning.js --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "gemini",
    "mcp",
    "model-context-protocol",
    "antigravity",
    "coding-agent",
    "gemini-connector"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
